diff --git a/scripts/docker-fs-bridge.py b/scripts/docker-fs-bridge.py
new file mode 100755
index 0000000..7e206ed
--- /dev/null
+++ b/scripts/docker-fs-bridge.py
@@ -0,0 +1,103 @@
+#!/usr/bin/python3
+#
+# Host file sharing (bind mounts) for Docker Desktop on HyperKit, started by the HyperKit wrapper that
+# scripts/docker-desktop-shim.sh installs.
+#
+# The guest reaches Docker's file server on vsock port 4099. HyperKit turns a guest connection to host port P into a
+# connect() on the unix socket <vsock dir>/00000002.<P as 8 hex digits>, and Docker Desktop 4.99 no longer listens there
+# ("skipping unsupported fileserver listen address vsock:4099" in the backend's log). Its file server does take
+# connections on filesystem-fd.sock, as file descriptors. Without this bridge every access to a host path blocks in the
+# guest, so a container with a host bind mount never gets past "Starting".
+#
+#   docker-fs-bridge.py [--pid PID] <vsock dir>
+#
+# <vsock dir> is the path= of HyperKit's virtio-sock device (.../com.docker.docker/Data/vms/0). With --pid the bridge
+# exits when that process (HyperKit) is gone.
+import array
+import errno
+import os
+import signal
+import socket
+import sys
+import time
+
+PORT = 4099
+POLL_SECONDS = 2.0
+
+
+def log(msg):
+    print(time.strftime("%Y-%m-%d %H:%M:%S"), f"[{os.getpid()}]", msg, flush=True)
+
+
+def alive(pid):
+    try:
+        os.kill(pid, 0)
+    except OSError as e:
+        return e.errno == errno.EPERM
+    return True
+
+
+def hand_over(conn, target):
+    """Give the guest's connection to the file server: one byte with the descriptor attached (SCM_RIGHTS)."""
+    out = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        out.connect(target)
+        out.sendmsg([b"\0"], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", [conn.fileno()]))])
+    finally:
+        out.close()
+
+
+def main(argv):
+    pid = None
+    if len(argv) >= 2 and argv[0] == "--pid":
+        pid = int(argv[1])
+        argv = argv[2:]
+    if len(argv) != 1:
+        sys.exit("usage: docker-fs-bridge.py [--pid PID] <vsock dir>")
+    vsock = os.path.realpath(argv[0])
+    data = os.path.dirname(os.path.dirname(vsock))      # .../Data/vms/0 -> .../Data
+    # A unix socket address holds about 100 bytes on macOS, so both sockets are named relative to Docker's data directory.
+    os.chdir(data)
+    listen = os.path.join(os.path.relpath(vsock, data), "00000002.%08x" % PORT)
+    target = "filesystem-fd.sock"
+
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
+    try:
+        os.unlink(listen)                               # left by an earlier HyperKit; its bridge is gone or about to go
+    except FileNotFoundError:
+        pass
+    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    srv.bind(listen)
+    inode = os.stat(listen).st_ino
+    srv.listen(64)
+    srv.settimeout(POLL_SECONDS)
+    log(f"listening on {os.path.join(data, listen)} for {'pid ' + str(pid) if pid else 'ever'}")
+    count = 0
+    try:
+        while True:
+            try:
+                conn, _ = srv.accept()
+            except socket.timeout:
+                if pid is not None and not alive(pid):
+                    log(f"pid {pid} is gone, exiting after {count} connection(s)")
+                    return
+                continue
+            count += 1
+            try:
+                hand_over(conn, target)
+                log(f"connection {count} handed to {target}")
+            except OSError as e:
+                log(f"connection {count} dropped, {target}: {e}")     # the guest dials again
+            finally:
+                conn.close()
+    finally:
+        srv.close()
+        try:
+            if os.stat(listen).st_ino == inode:         # not if a newer bridge has bound the name since
+                os.unlink(listen)
+        except OSError:
+            pass
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
