+/*
+ * System restart / power off. The M.2 card keeps standby power across a
+ * restart and, on this laptop, often across a shutdown too, so the next
+ * boot (macOS, Linux or Windows) finds the chip in whatever state we leave.
+ *
+ * Leave it the way Linux mt7921_pci_suspend() does, a state the firmware
+ * is built to sit in while powered: interrupts masked, DMA stopped,
+ * ownership handed back to the firmware (SET_OWN), and bus mastering off so
+ * the card cannot DMA into memory the next OS owns. The firmware keeps
+ * running; the next attach takes the chip back, WFSYS-resets it and gets
+ * PATCH_IS_DL, which mwx_load_firmware() handles.
+ *
+ * v3 did a WFSYS reset here and left the chip in driver own with no
+ * firmware. Every boot where Wi-Fi then failed (2026-11-04, three times)
+ * followed a clean shutdown that ran it; the chip refused the ownership
+ * handshake on the next boot. No MCU commands: nothing here can wait on the
+ * firmware and stall the shutdown.
+ */
+void
+MtkMwx::shutdown()
+{
+	struct mwx_softc *sc = com;
+
+	if (sc == NULL || sc->sc_memh == 0)
+		return;
+	MWX_DEV_LOG(sc, "shutdown: quiescing the chip for the next OS lpctl=0x%08x\n",
+	    mwx_read(sc, MT_CONN_ON_LPCTL));
+	sc->sc_suspended = 1;		/* interrupt handler: hands off */
+	mwx_write(sc, MT_WFDMA0_HOST_INT_ENA, 0);
+	mwx_write(sc, MT_PCIE_MAC_INT_ENABLE, 0);
+	if (mwx_mcu_drv_pmctrl(sc) != 0)
+		MWX_DEV_LOG(sc, "shutdown: driver own failed\n");
+	mwx_dma_disable(sc, 1);
+	if (mwx_mcu_fw_pmctrl(sc) != 0)
+		MWX_DEV_LOG(sc, "shutdown: firmware own failed\n");
+	if (pci != NULL && pci->pa_tag != NULL)
+		pci->pa_tag->setBusMasterEnable(false);
+	sc->sc_fw_loaded = 0;
+	MWX_DEV_LOG(sc, "shutdown: done lpctl=0x%08x\n",
+	    mwx_read(sc, MT_CONN_ON_LPCTL));
+}
