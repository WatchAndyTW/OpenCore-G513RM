+/*
+ * System restart / power off. A warm reboot does not power-cycle the M.2
+ * card: without this the next OS (Linux, Windows, or macOS again) finds
+ * the firmware running and the DMA rings pointing at memory this kernel no
+ * longer owns. Do what Linux mt7921e_unregister_device() does: take driver
+ * ownership, stop DMA, WFSYS reset. No MCU commands: nothing here can wait
+ * on the firmware and stall the shutdown.
+ */
+void
+MtkMwx::shutdown()
+{
+	struct mwx_softc *sc = com;
+
+	if (sc == NULL || sc->sc_memh == 0)
+		return;
+	MWX_DEV_LOG(sc, "shutdown: resetting the chip for the next OS lpctl=0x%08x\n",
+	    mwx_read(sc, MT_CONN_ON_LPCTL));
+	sc->sc_suspended = 1;		/* interrupt handler: hands off */
+	mwx_write(sc, MT_WFDMA0_HOST_INT_ENA, 0);
+	if (mwx_mcu_drv_pmctrl(sc) != 0)
+		MWX_DEV_LOG(sc, "shutdown: driver own failed\n");
+	mwx_dma_disable(sc, 1);
+	if (mwx_wfsys_reset(sc) != 0)
+		MWX_DEV_LOG(sc, "shutdown: WFSYS reset failed\n");
+	sc->sc_fw_loaded = 0;
+	MWX_DEV_LOG(sc, "shutdown: done\n");
+}
